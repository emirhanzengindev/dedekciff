{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@case-001/shared": ["packages/shared/src/index.ts"],
      "@case-001/validation": ["packages/validation/src/index.ts"],
      "@case-001/case-engine": ["packages/case-engine/src/index.ts"]
    }
  }
}
